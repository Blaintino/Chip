<?xml version="1.0" encoding="utf-8"?>
<!-- Arbeitszeit im Stempel-Knopf des Widgets: zählt im Launcher selbst weiter, ohne dass Chip
     minütlich neu zeichnen muss. Farbe setzt TodayWidget. -->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stempel_chronometer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="sans-serif-medium"
    android:maxLines="1"
    android:textColor="#FFFFFFFF"
    android:textSize="16sp" />
